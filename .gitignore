# macOS / editor
.DS_Store
*.swp

# Swift / SwiftPM
.build/
DerivedData/
*.xcodeproj
.swiftpm/
Package.resolved

# Xcode per-user state, test results, and generated products
**/*.xcodeproj/xcuserdata/
**/*.xcworkspace/xcuserdata/
*.xcuserstate
*.xccheckout
*.xcscmblueprint
*.xcresult
*.xcactivitylog
*.app/
*.dSYM/
*.ipa

# Local Apple signing material (never commit)
*.mobileprovision
*.provisionprofile
*.cer
*.crt
*.der
*.pem
*.key
*.p12
*.pfx

# Local iOS app host project
!ios-app/*.xcodeproj/
!ios-app/*.xcodeproj/**
ios-app/build/

# Backend (Cloudflare Worker)
backend/node_modules/
backend/.wrangler/
backend/dist/

# Local IPhoneMirror runtime logs
tools/IPhoneMirror/*.log
tools/IPhoneMirror/*.pid

# Local secrets / config (never commit)
*.env
.env
.env.*
!.env.example
keys/
*.p8

# GolfTrace local hardware-UAT/reference captures may contain personal video
apps/GolfTrace/Design/**/*-UAT.*
apps/GolfTrace/Design/**/*-reference.*

# OSS-prep scratch
_os*
_internal/
